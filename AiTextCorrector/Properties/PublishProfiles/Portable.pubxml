<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil « Portable » : un seul .exe framework-dependent.
  - Nécessite le .NET 8 Desktop Runtime sur le PC cible.
  - Si le runtime est absent, l'apphost Windows affiche automatiquement une
    boîte de dialogue invitant à le télécharger/installer.

  Publier avec :
    dotnet publish -c Release /p:PublishProfile=Portable
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Publish\Portable</PublishDir>

    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
