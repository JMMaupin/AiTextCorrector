<ui:FluentWindow x:Class="AiTextCorrector.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Configurer le raccourci"
        Icon="pack://application:,,,/Resources/AICorrector.ico"
        Width="470"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Configurer le raccourci" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,16">
            <ui:TextBlock Text="Clique dans le champ ci-dessous, puis appuie sur la combinaison souhaitée (au moins un modificateur — Ctrl, Shift, Alt ou Win — plus une touche)."
                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Border Name="CaptureBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="6">
                <ui:TextBox Name="CaptureBox" IsReadOnly="True" FontSize="16"
                            PlaceholderText="Clique ici puis appuie sur les touches…"
                            PreviewKeyDown="CaptureBox_PreviewKeyDown"/>
            </Border>

            <Border Name="StatusBorder" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                <ui:TextBlock Name="StatusTextBlock" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Annuler" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                <ui:Button Name="SaveButton" Content="Enregistrer" Appearance="Primary" MinWidth="120" IsEnabled="False" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
