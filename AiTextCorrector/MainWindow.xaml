<ui:FluentWindow x:Class="AiTextCorrector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="AI Text Corrector V1"
        Icon="pack://application:,,,/Resources/AICorrector.ico"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        MinHeight="560"
        MinWidth="800"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AI Text Corrector V1"/>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="12" Margin="0,0,0,12">
                <WrapPanel>
                    <ui:TextBlock Text="Provider:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Name="ProviderComboBox" Width="160" Margin="0,0,18,0" VerticalAlignment="Center" SelectionChanged="ProviderComboBox_SelectionChanged">
                        <ComboBoxItem Content="OpenAI"/>
                        <ComboBoxItem Content="Anthropic"/>
                    </ComboBox>
                    <CheckBox Name="AutoCopyCheckBox" Content="Copie auto après correction" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Name="AsciiOnlyCheckBox" Content="Mode ASCII simple" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <CheckBox Name="AutoPasteBackCheckBox" Content="Recoller automatiquement" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <ui:Button Name="HotkeyButton" Content="Raccourci…" Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,8,0" VerticalAlignment="Center" Click="HotkeyButton_Click"/>
                    <ui:Button Name="ApiButton" Content="API" Icon="{ui:SymbolIcon Key24}" Appearance="Secondary" VerticalAlignment="Center" Click="ApiButton_Click"
                               ToolTip="Configurer les clés API"/>
                </WrapPanel>
            </ui:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Texte source" Padding="8" Margin="0,0,6,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Name="PasteClipboardButton" Content="Coller depuis le presse-papiers" MinWidth="220" Margin="0,0,8,0" Click="PasteClipboardButton_Click"/>
                            <ui:Button Name="ClearInputButton" Content="Vider" MinWidth="90" Click="ClearInputButton_Click"/>
                        </StackPanel>
                        <ui:TextBox Name="InputTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                    TextWrapping="Wrap" FontSize="14" PlaceholderText="Tape ou colle ton texte ici" ToolTip="Tape ou colle ton texte ici"/>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Texte corrigé" Padding="8" Margin="6,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Name="CopyResultButton" Content="Copier le résultat" MinWidth="150" Margin="0,0,8,0" Click="CopyResultButton_Click"/>
                            <ui:Button Name="PasteBackButton" Content="Recoller dans l'app" MinWidth="150" Margin="0,0,8,0" Click="PasteBackButton_Click"/>
                            <ui:Button Name="ClearOutputButton" Content="Vider" MinWidth="90" Click="ClearOutputButton_Click"/>
                        </StackPanel>
                        <ui:TextBox Name="OutputTextBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                    TextWrapping="Wrap" FontSize="14" PlaceholderText="Le texte corrigé apparaîtra ici"/>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                <ui:Button Name="StrictCorrectionButton" Content="Correction stricte" Appearance="Primary" MinWidth="150" Margin="0,0,8,0" Click="StrictCorrectionButton_Click"/>
                <ui:Button Name="RewriteLightButton" Content="Correction + reformulation" Appearance="Primary" MinWidth="210" Margin="0,0,8,0" Click="RewriteLightButton_Click"/>
                <ui:Button Name="ProfessionalButton" Content="Version pro" Appearance="Primary" MinWidth="120" Margin="0,0,8,0" Click="ProfessionalButton_Click"/>
                <ui:Button Name="CustomButton" Content="Prompt perso" Appearance="Primary" MinWidth="120" Click="CustomButton_Click"/>
            </WrapPanel>

            <ui:TextBlock Name="StatusTextBlock" Grid.Row="3" Text="Prêt"
                          Appearance="Secondary" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
