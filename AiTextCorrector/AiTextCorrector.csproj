<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Icône gravée dans le fichier .exe (Explorateur, barre des tâches, Alt+Tab). -->
    <ApplicationIcon>Resources\AICorrector.ico</ApplicationIcon>

    <!-- Source unique du nom et de la version affichés : l'interface les lit via
         AppInfo plutôt que de les coder en dur. Alimente aussi les propriétés du
         fichier .exe et les rapports d'erreur Windows, qui indiquaient 1.0.0.0. -->
    <Product>AI Text Corrector</Product>
    <!-- Licence MIT (fichier LICENSE) ; visible dans les propriétés de l'exe. -->
    <Copyright>Copyright (c) 2026 JMMaupin</Copyright>
    <!-- SemVer MAJEUR.MINEUR.CORRECTIF, incrémenté par les scripts locaux, hors dépôt
         (scripts\bump-version.ps1) :
         - publish.cmd : +0.0.1 à chaque exe de test publié (corrections, mises au point) ;
         - release.cmd : +0.0.1 pour une release de correctifs, +0.1.0 pour une release
           avec des nouveautés, +1.0.0 pour un gros changement (dont l'UI principale).
         Pas de modification à la main, sauf cas particulier. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms est activé pour le NotifyIcon (icône de la zone de notification),
         mais ses global usings entrent en conflit avec WPF (System.Windows). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" Version="2.2.0" />
    <PackageReference Include="Anthropic" Version="12.29.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Embarquée comme ressource (chargée via pack URI) : pas besoin de la copier
         sur le disque, ce qui fonctionne aussi en publication single-file. -->
    <Resource Include="Resources\AICorrector.ico" />
  </ItemGroup>
</Project>
