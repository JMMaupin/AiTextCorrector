<ui:FluentWindow x:Class="AiTextCorrector.ApiKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clés API"
        Icon="pack://application:,,,/Resources/AICorrector.ico"
        Width="520"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Clés API" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,8">
            <ui:TextBlock Text="Les clés sont stockées dans le registre utilisateur (HKCU). Une variable d'environnement, si elle existe, reste prioritaire."
                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <ui:TextBlock Text="Clé OpenAI" Margin="0,0,0,4"/>
            <PasswordBox Name="OpenAiKeyBox" FontSize="14" Margin="0,0,0,12" GotFocus="OpenAiKeyBox_GotFocus"/>

            <ui:TextBlock Text="Clé Anthropic / Claude" Margin="0,0,0,4"/>
            <PasswordBox Name="AnthropicKeyBox" FontSize="14" GotFocus="AnthropicKeyBox_GotFocus"/>

            <ui:TextBlock Name="ErrorTextBlock" Foreground="#EF4444" TextWrapping="Wrap"
                          Visibility="Collapsed" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
            <ui:Button Content="Annuler" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <ui:Button Name="SaveButton" Content="Enregistrer" Appearance="Primary" MinWidth="120" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
