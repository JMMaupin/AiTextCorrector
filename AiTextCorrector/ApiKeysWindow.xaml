<ui:FluentWindow x:Class="AiTextCorrector.ApiKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Clés API"
        Icon="pack://application:,,,/Resources/AICorrector.ico"
        Width="560"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Clés API" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,8">
            <ui:TextBlock Text="Les clés sont stockées dans le registre utilisateur (HKCU). Une variable d'environnement, si elle existe, reste prioritaire."
                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ui:TextBlock Text="Laisse un champ vide pour conserver la clé déjà enregistrée. Saisis une valeur pour la remplacer, ou utilise « Effacer » pour la supprimer."
                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="OpenAiClearButton" Content="Effacer"
                               Appearance="Secondary" Padding="10,2" Click="OpenAiClear_Click"/>
                    <ui:TextBlock Text="Clé OpenAI" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="OpenAiStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="OpenAiKeyBox" FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="AnthropicClearButton" Content="Effacer"
                               Appearance="Secondary" Padding="10,2" Click="AnthropicClear_Click"/>
                    <ui:TextBlock Text="Clé Anthropic / Claude" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="AnthropicStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="AnthropicKeyBox" FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="GlmClearButton" Content="Effacer"
                               Appearance="Secondary" Padding="10,2" Click="GlmClear_Click"/>
                    <ui:TextBlock Text="Clé GLM (Z.ai)" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="GlmStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="GlmKeyBox" FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,4">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="GroqClearButton" Content="Effacer"
                               Appearance="Secondary" Padding="10,2" Click="GroqClear_Click"/>
                    <ui:TextBlock Text="Clé Groq" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="GroqStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="GroqKeyBox" FontSize="14"/>
            </StackPanel>

            <ui:TextBlock Name="ErrorTextBlock" Foreground="#EF4444" TextWrapping="Wrap"
                          Visibility="Collapsed" Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
            <ui:Button Content="Annuler" MinWidth="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <ui:Button Name="SaveButton" Content="Enregistrer" Appearance="Primary" MinWidth="120" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
