<UserControl x:Class="AiTextCorrector.Settings.HotkeySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <ui:TextBlock Text="Shortcut that opens the window from any application and captures the selected text."
                      TextWrapping="Wrap" Margin="0,0,0,4"/>
        <ui:TextBlock Text="Click the field below, then press the combination you want: at least one modifier (Ctrl, Shift, Alt or Win) plus a key."
                      Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Name="CaptureBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="6">
            <ui:TextBox Name="CaptureBox" IsReadOnly="True" FontSize="16"
                        PlaceholderText="Click here, then press the keys…"
                        PreviewKeyDown="CaptureBox_PreviewKeyDown"/>
        </Border>

        <Border Name="StatusBorder" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
            <ui:TextBlock Name="StatusTextBlock" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
    </StackPanel>
</UserControl>
