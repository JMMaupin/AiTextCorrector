<UserControl x:Class="AiTextCorrector.Settings.HotkeySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:AiTextCorrector.Localization">
    <StackPanel>
        <ui:TextBlock Text="{loc:Text Hotkey.Intro}"
                      TextWrapping="Wrap" Margin="0,0,0,4"/>
        <ui:TextBlock Text="{loc:Text Hotkey.Help}"
                      Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Name="CaptureBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="6">
            <ui:TextBox Name="CaptureBox" IsReadOnly="True" FontSize="16"
                        PlaceholderText="{loc:Text Hotkey.Placeholder}"
                        PreviewKeyDown="CaptureBox_PreviewKeyDown"/>
        </Border>

        <Border Name="StatusBorder" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
            <ui:TextBlock Name="StatusTextBlock" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
    </StackPanel>
</UserControl>
