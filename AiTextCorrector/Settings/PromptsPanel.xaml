<UserControl x:Class="AiTextCorrector.Settings.PromptsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:AiTextCorrector.Localization">
    <DockPanel>
        <ui:TextBlock DockPanel.Dock="Top" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,12"
                      Text="{loc:Text Prompts.Intro}"/>

        <ui:TextBlock Name="ErrorTextBlock" DockPanel.Dock="Bottom" Foreground="#EF4444" TextWrapping="Wrap"
                      Margin="0,8,0,0" Visibility="Collapsed"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="PromptList" Margin="0,0,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <DockPanel Margin="0,0,0,4">
                                <ui:Button DockPanel.Dock="Right" Content="{loc:Text Prompts.Reset}" Icon="{ui:SymbolIcon ArrowReset24}"
                                           Appearance="Secondary" Padding="10,2" Click="Reset_Click"
                                           ToolTip="{loc:Text Prompts.ResetTooltip}"/>
                                <ui:TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                        ClearButtonEnabled="False"
                                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180"
                                        VerticalScrollBarVisibility="Auto"/>
                            <ui:TextBlock Text="{Binding Hint}" Visibility="{Binding HintVisibility}"
                                          Appearance="Secondary" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
