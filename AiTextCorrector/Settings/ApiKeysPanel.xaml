<UserControl x:Class="AiTextCorrector.Settings.ApiKeysPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:AiTextCorrector.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <ui:TextBlock Text="{loc:Text ApiKeys.Storage}"
                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ui:TextBlock Text="{loc:Text ApiKeys.Help}"
                          Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- Libellés des boutons Clear / Restore posés par le code (SetStatus). -->
            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="OpenAiClearButton"
                               Appearance="Secondary" Padding="10,2" Click="OpenAiClear_Click"/>
                    <ui:TextBlock Text="{loc:Text ApiKeys.OpenAi}" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="OpenAiStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="OpenAiKeyBox" FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="AnthropicClearButton"
                               Appearance="Secondary" Padding="10,2" Click="AnthropicClear_Click"/>
                    <ui:TextBlock Text="{loc:Text ApiKeys.Anthropic}" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="AnthropicStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="AnthropicKeyBox" FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,14">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="GlmClearButton"
                               Appearance="Secondary" Padding="10,2" Click="GlmClear_Click"/>
                    <ui:TextBlock Text="{loc:Text ApiKeys.Glm}" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="GlmStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="GlmKeyBox" FontSize="14"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,4">
                <DockPanel Margin="0,0,0,4">
                    <ui:Button DockPanel.Dock="Right" Name="GroqClearButton"
                               Appearance="Secondary" Padding="10,2" Click="GroqClear_Click"/>
                    <ui:TextBlock Text="{loc:Text ApiKeys.Groq}" VerticalAlignment="Center"/>
                    <ui:TextBlock Name="GroqStatusText" Appearance="Secondary"
                                  VerticalAlignment="Center" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <PasswordBox Name="GroqKeyBox" FontSize="14"/>
            </StackPanel>

            <ui:TextBlock Name="EnvironmentNoteText" Foreground="#EF4444" TextWrapping="Wrap"
                          Visibility="Collapsed" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
