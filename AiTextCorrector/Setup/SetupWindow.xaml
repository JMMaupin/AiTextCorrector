<ui:FluentWindow x:Class="AiTextCorrector.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Install AI Text Corrector"
        Icon="pack://application:,,,/Resources/AICorrector.ico"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="SetupTitleBar" Grid.Row="0" Title="Install AI Text Corrector" ShowMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="20,8,20,16">
            <ui:TextBlock Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <ui:TextBlock Text="It will be installed for your account only, without administrator rights, in:"
                          Appearance="Secondary" TextWrapping="Wrap"/>
            <ui:TextBlock Name="InstallPathText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <CheckBox Name="StartWithWindowsCheckBox" Content="Start with Windows" IsChecked="True"
                      ToolTip="Keeps the hotkey available from the moment you log in"/>

            <!-- Ancienne installation manuelle : affichée seulement si elle existe. -->
            <ui:TextBlock Name="LegacyInstallText" Appearance="Secondary" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Run without installing" MinWidth="170" Margin="0,0,8,0" Click="RunWithoutInstalling_Click"
                           ToolTip="Use this copy as is; nothing is written to your computer"/>
                <ui:Button Content="Install" Appearance="Primary" MinWidth="120" IsDefault="True" Click="Install_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
